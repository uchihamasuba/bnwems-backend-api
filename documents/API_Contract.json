{
  "api_contract_version": "1.0.0",
  "base_url": "/api/v1",
  "environment_constraints": {
    "backend": "Node.js + Express.js + Prisma ORM + MySQL",
    "frontend_web": "Next.js + Axios Interceptors",
    "frontend_mobile": "Flutter + Dio Transformers",
    "security": "JWT Bearer Token Authentication in Header"
  },
  "global_error_response_structure": {
    "description": "Cấu trúc phản hồi chung áp dụng cho tất cả các mã lỗi 400, 401, 403, 404, 500",
    "schema": {
      "success": { "type": "Boolean", "example": false },
      "statusCode": { "type": "Number", "example": 400 },
      "message": { "type": "String", "example": "Thông báo lỗi cụ thể dựa trên Business Rules / System Messages của SRS." },
      "errorDetails": { "type": "Object/Array", "example": null }
    }
  },
  "modules": {
    "Module_01_Authentication_Profile": [
      {
        "path": "/api/v1/auth/login",
        "method": "POST",
        "description": "Xử lý đăng nhập hệ thống cho tất cả các Actor (Admin, Manager, Leader, Tech Staff). Trả về JWT Token và thông tin phân quyền lồng nhau (Prisma Role Relation).",
        "authentication": "None",
        "request_headers": {
          "Content-Type": "application/json"
        },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "username": { "type": "String", "status": "Required", "example": "manager_fpt" },
            "password": { "type": "String", "status": "Required", "example": "P@ssword2026" }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, trả về Bearer Token phục vụ lưu trữ tại Axios/Dio Client.",
            "body": {
              "success": true,
              "statusCode": 200,
              "data": {
                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsInJvbGUiOiJNQU5BR0VSIn0...",
                "user": {
                  "id": 1,
                  "username": "manager_fpt",
                  "fullName": "Nguyễn Văn Quản Lý",
                  "email": "quanly@fpt.edu.vn",
                  "role": {
                    "id": 2,
                    "roleName": "Manager",
                    "permissions": ["VIEW_ORDER_LIST", "CREATE_QUOTATION", "ALLOCATE_STAFF", "APPROVE_CHANGE_REQUEST"]
                  }
                }
              }
            }
          },
          "400": { "body": { "success": false, "statusCode": 400, "message": "Dữ liệu đầu vào không hợp lệ hoặc thiếu trường bắt buộc." } },
          "401": { "body": { "success": false, "statusCode": 401, "message": "Tên đăng nhập hoặc mật khẩu không chính xác (MSG-LG01)." } },
          "403": { "body": { "success": false, "statusCode": 403, "message": "Tài khoản của bạn đã bị vô hiệu hóa hoặc tạm khóa (MSG-LG02)." } },
          "500": { "body": { "success": false, "statusCode": 500, "message": "Lỗi hệ thống nội bộ Backend." } }
        }
      },
      {
        "path": "/api/v1/auth/change-password",
        "method": "PUT",
        "description": "Cho phép người dùng hiện tại thay đổi mật khẩu định kỳ (UC-04).",
        "authentication": "Bearer JWT",
        "request_headers": {
          "Authorization": "Bearer <JWT_TOKEN>",
          "Content-Type": "application/json"
        },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "oldPassword": { "type": "String", "status": "Required", "example": "P@ssword2026" },
            "newPassword": { "type": "String", "status": "Required", "example": "NewP@ss2026!" }
          }
        },
        "responses": {
          "200": {
            "body": {
              "success": true,
              "statusCode": 200,
              "message": "Thay đổi mật khẩu thành công."
            }
          },
          "400": { "body": { "success": false, "statusCode": 400, "message": "Mật khẩu mới không đủ độ an toàn hoặc trùng mật khẩu cũ." } },
          "401": { "body": { "success": false, "statusCode": 401, "message": "Mật khẩu hiện tại không chính xác (MSG-CP05)." } },
          "500": { "body": { "success": false, "statusCode": 500, "message": "Hệ thống không thể cập nhật mật khẩu. Hãy thử lại sau (MSG-CP06)." } }
        }
      }
    ],
    "Module_02_User_Role_Management": [
      {
        "path": "/api/v1/admin/users",
        "method": "GET",
        "description": "Admin lấy danh sách người dùng toàn hệ thống, hỗ trợ phân trang và tìm kiếm theo tên/phòng ban.",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "query",
          "properties": {
            "page": { "type": "Number", "status": "Optional", "example": 1 },
            "limit": { "type": "Number", "status": "Optional", "example": 10 },
            "search": { "type": "String", "status": "Optional", "example": "Nguyễn" },
            "roleId": { "type": "Number", "status": "Optional", "example": 3 }
          }
        },
        "responses": {
          "200": {
            "description": "Trả về danh sách User kết hợp liên kết Relation đối tượng Role trong Prisma.",
            "body": {
              "success": true,
              "statusCode": 200,
              "pagination": { "totalItems": 45, "totalPages": 5, "currentPage": 1, "limit": 10 },
              "data": [
                {
                  "id": 12,
                  "username": "leader_nam",
                  "fullName": "Nguyễn Hoàng Nam",
                  "email": "namnh@fpt.edu.vn",
                  "phone": "0912345678",
                  "status": "ACTIVE",
                  "role": { "id": 3, "roleName": "Leader Staff" }
                }
              ]
            }
          },
          "403": { "body": { "success": false, "statusCode": 403, "message": "Bạn không có quyền truy cập tính năng quản trị này." } }
        }
      },
      {
        "path": "/api/v1/admin/users",
        "method": "POST",
        "description": "Admin tạo mới một tài khoản nhân sự trong hệ thống (UC-09).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "username": { "type": "String", "status": "Required", "example": "tech_dung" },
            "password": { "type": "String", "status": "Required", "example": "InitP@ss123" },
            "fullName": { "type": "String", "status": "Required", "example": "Trần Việt Dũng" },
            "email": { "type": "String", "status": "Required", "example": "dungtv@fpt.edu.vn" },
            "phone": { "type": "String", "status": "Required", "example": "0987654321" },
            "roleId": { "type": "Number", "status": "Required", "example": 4 }
          }
        },
        "responses": {
          "201": {
            "body": {
              "success": true,
              "statusCode": 201,
              "message": "Tài khoản người dùng đã được khởi tạo thành công (MSG-AU04).",
              "data": { "id": 15, "username": "tech_dung", "createdAt": "2026-06-17T10:00:00Z" }
            }
          },
          "400": { "body": { "success": false, "statusCode": 400, "message": "Tên đăng nhập đã tồn tại trong hệ thống (MSG-AU03)." } }
        }
      },
      {
        "path": "/api/v1/admin/users/:id",
        "method": "DELETE",
        "description": "Vô hiệu hóa tài khoản người dùng (Deactivate Account - Soft Delete để bảo toàn ràng buộc khóa ngoại MySQL).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "path",
          "properties": { "id": { "type": "Number", "status": "Required", "example": 15 } }
        },
        "responses": {
          "200": { "body": { "success": true, "statusCode": 200, "message": "Đã vô hiệu hóa tài khoản người dùng thành công." } },
          "404": { "body": { "success": false, "statusCode": 404, "message": "Không tìm thấy thông tin người dùng được chỉ định." } }
        }
      }
    ],
    "Module_03_Master_Reference_Data_Management": [
      {
        "path": "/api/v1/equipment",
        "method": "GET",
        "description": "Lấy danh mục thiết bị vật tư phục vụ hiển thị trên Web/Mobile (Hỗ trợ phân loại và tìm kiếm).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "query",
          "properties": {
            "categoryId": { "type": "Number", "status": "Optional", "example": 5 },
            "search": { "type": "String", "status": "Optional", "example": "Âm thanh" }
          }
        },
        "responses": {
          "200": {
            "body": {
              "success": true,
              "statusCode": 200,
              "data": [
                {
                  "id": 101,
                  "sku": "EQ-AUD-LOA01",
                  "equipmentName": "Loa Hội Trường Công Suất Lớn JBL",
                  "specification": "1000W, Trở kháng 8 Ohm",
                  "totalInventory": 50,
                  "availableInventory": 35,
                  "unitPrice": 450000,
                  "category": { "id": 5, "categoryName": "Thiết bị âm thanh" }
                }
              ]
            }
          }
        }
      }
    ],
    "Module_04_Policy_Configuration": [
      {
        "path": "/api/v1/admin/policies",
        "method": "POST",
        "description": "Admin cấu hình/thiết lập quy định chính sách mới về đặt cọc, hủy đơn hoặc đền bù thiết bị phát sinh hư hỏng (UC-34/35/36).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "policyName": { "type": "String", "status": "Required", "example": "Chính sách đặt cọc sự kiện cao cấp" },
            "type": { "type": "String", "status": "Required", "enum": ["DEPOSIT", "CANCELLATION", "COMPENSATION"], "example": "DEPOSIT" },
            "rulesJson": { 
              "type": "Object", 
              "status": "Required", 
              "example": { "minDepositPercentage": 30, "gracePeriodDays": 3 } 
            },
            "effectiveDate": { "type": "String", "status": "Required", "example": "2026-07-01T00:00:00Z" }
          }
        },
        "responses": {
          "201": { "body": { "success": true, "statusCode": 201, "message": "Chính sách mới đã được cấu hình thành công." } },
          "400": { "body": { "success": false, "statusCode": 400, "message": "Tỷ lệ phần trăm hoặc ngưỡng ngày thiết lập không hợp lệ (MSG-CPOL01)." } }
        }
      }
    ],
    "Module_05_Customer_Management": [
      {
        "path": "/api/v1/customers",
        "method": "POST",
        "description": "Manager đăng ký thông tin khách hàng mới phục vụ lập báo giá và hợp đồng (UC-48).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "fullName": { "type": "String", "status": "Required", "example": "Công ty TNHH Sự Kiện Hòa Bình" },
            "phone": { "type": "String", "status": "Required", "example": "0243123456" },
            "email": { "type": "String", "status": "Required", "example": "contact@hoabinspeed.com" },
            "address": { "type": "String", "status": "Required", "example": "Số 29 Cầu Giấy, Hà Nội" },
            "companyTaxCode": { "type": "String", "status": "Optional", "example": "0102030405" }
          }
        },
        "responses": {
          "201": {
            "body": {
              "success": true,
              "statusCode": 201,
              "data": { "id": 50, "fullName": "Công ty TNHH Sự Kiện Hòa Bình", "customerCode": "CUST-2026-0050" }
            }
          }
        }
      }
    ],
    "Module_06_Quotation_Order_Lifecycle_Management": [
      {
        "path": "/api/v1/orders",
        "method": "GET",
        "description": "Lấy danh sách đơn hàng toàn hệ thống kèm trạng thái bộ lọc (Dành cho Web Manager theo dõi tổng quan).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "query",
          "properties": {
            "status": { "type": "String", "status": "Optional", "enum": ["DRAFT", "PENDING_SURVEY", "WAITING_FOR_DEPOSIT", "EXECUTING", "RETURNED", "SETTLED"], "example": "WAITING_FOR_DEPOSIT" },
            "page": { "type": "Number", "status": "Optional", "example": 1 }
          }
        },
        "responses": {
          "200": {
            "body": {
              "success": true,
              "statusCode": 200,
              "data": [
                {
                  "id": 88,
                  "orderCode": "ORD-2026-0088",
                  "status": "WAITING_FOR_DEPOSIT",
                  "eventDate": "2026-08-20T08:00:00Z",
                  "customer": { "fullName": "Công ty TNHH Sự Kiện Hòa Bình", "phone": "0243123456" }
                }
              ]
            }
          }
        }
      },
      {
        "path": "/api/v1/orders/:id",
        "method": "GET",
        "description": "Lấy thông tin chi tiết cấu trúc lồng nhau của một Đơn hàng bao gồm thông tin Khách hàng, Bảng báo giá và Danh sách thiết bị (Prisma Relational Include Deep Mapping).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "path",
          "properties": { "id": { "type": "Number", "status": "Required", "example": 88 } }
        },
        "responses": {
          "200": {
            "description": "Phản hồi thành công mang cấu trúc dữ liệu quan hệ phức hợp (Relational Model).",
            "body": {
              "success": true,
              "statusCode": 200,
              "data": {
                "id": 88,
                "orderCode": "ORD-2026-0088",
                "status": "WAITING_FOR_DEPOSIT",
                "createdAt": "2026-06-17T11:00:00Z",
                "customer": {
                  "id": 50,
                  "fullName": "Công ty TNHH Sự Kiện Hòa Bình",
                  "phone": "0243123456",
                  "address": "Số 29 Cầu Giấy, Hà Nội"
                },
                "quotation": {
                  "id": 12,
                  "totalAmount": 150000000,
                  "depositAmount": 45000000,
                  "items": [
                    {
                      "id": 1,
                      "equipmentId": 101,
                      "quantity": 10,
                      "unitPrice": 450000,
                      "equipment": { "sku": "EQ-AUD-LOA01", "equipmentName": "Loa Hội Trường Công Suất Lớn JBL" }
                    }
                  ]
                }
              }
            }
          },
          "404": { "body": { "success": false, "statusCode": 404, "message": "Đơn hàng không tồn tại trên hệ thống." } }
        }
      },
      {
        "path": "/api/v1/orders/:id/quotations",
        "method": "POST",
        "description": "Manager thiết lập bảng báo giá thiết bị chi tiết gắn liền với mã định danh đơn hàng (UC-50).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "items": {
              "type": "Array",
              "status": "Required",
              "example": [{ "equipmentId": 101, "quantity": 10, "unitPrice": 450000 }]
            },
            "depositAmount": { "type": "Number", "status": "Required", "example": 45000000 },
            "notes": { "type": "String", "status": "Optional", "example": "Báo giá chưa bao gồm VAT" }
          }
        },
        "responses": {
          "201": { "body": { "success": true, "statusCode": 201, "message": "Tạo báo giá thành công cho đơn hàng.", "quotationId": 12 } }
        }
      },
      {
        "path": "/api/v1/quotations/:id/confirm",
        "method": "POST",
        "description": "Chuyển đổi trạng thái đơn hàng sang trạng thái chờ thanh toán đặt cọc sau khi thống nhất báo giá với khách hàng (UC-52).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "path",
          "properties": { "id": { "type": "Number", "status": "Required", "example": 12 } }
        },
        "responses": {
          "200": { "body": { "success": true, "statusCode": 200, "message": "Xác nhận báo giá thành công. Trạng thái đơn hàng chuyển sang Chờ Đặt Cọc." } }
        }
      }
    ],
    "Module_07_Survey_Management": [
      {
        "path": "/api/v1/surveys/schedule",
        "method": "POST",
        "description": "Manager lên lịch khảo sát thực địa hiện trường thi công sự kiện và phân phối công việc cho Leader Staff (UC-53).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "orderId": { "type": "Number", "status": "Required", "example": 88 },
            "leaderStaffId": { "type": "Number", "status": "Required", "example": 12 },
            "surveyDate": { "type": "String", "status": "Required", "example": "2026-06-20T09:00:00Z" },
            "locationNotes": { "type": "String", "status": "Required", "example": "Khảo sát mặt bằng sảnh ngoài trời tòa nhà Alpha" }
          }
        },
        "responses": {
          "201": { "body": { "success": true, "statusCode": 201, "message": "Đã xếp lịch khảo sát và thông báo đến Leader Staff thành công." } }
        }
      },
      {
        "path": "/api/v1/surveys/:id/report",
        "method": "PUT",
        "description": "Leader Staff nộp báo cáo kết quả khảo sát địa điểm trực tiếp từ Mobile App (Đính kèm hình ảnh minh chứng thực địa).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "surveyNotes": { "type": "String", "status": "Required", "example": "Mặt bằng nghiêng 5 độ, cần gia cố chân đế loa." },
            "siteConditions": { "type": "String", "status": "Required", "example": "Nguồn điện thi công ổn định 220V." },
            "evidenceImages": { "type": "Array", "status": "Required", "example": ["https://s3.storage/survey-88/img1.png"] }
          }
        },
        "responses": {
          "200": { "body": { "success": true, "statusCode": 200, "message": "Nộp báo cáo khảo sát thực địa thành công (UC-65)." } }
        }
      }
    ],
    "Module_08_Inventory_Staff_Operation": [
      {
        "path": "/api/v1/inventory/check",
        "method": "GET",
        "description": "Kiểm tra tính khả dụng của danh mục vật tư thiết bị trong kho dựa trên khoảng thời gian thuê (Date-based Inventory Management - Tránh xung đột trùng lặp lịch sự kiện) (UC-66/67).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>" },
        "request_parameters_body": {
          "location": "query",
          "properties": {
            "startDate": { "type": "String", "status": "Required", "example": "2026-08-19T00:00:00Z" },
            "endDate": { "type": "String", "status": "Required", "example": "2026-08-21T23:59:59Z" },
            "equipmentIds": { "type": "String", "status": "Required", "example": "101,102" }
          }
        },
        "responses": {
          "200": {
            "body": {
              "success": true,
              "statusCode": 200,
              "data": [
                { "equipmentId": 101, "requestedQuantity": 10, "availableInStock": 35, "hasConflict": false }
              ]
            }
          }
        }
      },
      {
        "path": "/api/v1/operations/pick-list",
        "method": "POST",
        "description": "Tạo danh sách chuẩn bị và bốc dỡ thiết bị vật tư ra khỏi kho (Pick List) giao cho đội thực địa (UC-68).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
          "location": "body",
          "properties": {
            "orderId": { "type": "Number", "status": "Required", "example": 88 },
            "warehouseId": { "type": "Number", "status": "Required", "example": 1 },
            "items": { "type": "Array", "status": "Required", "example": [{ "equipmentId": 101, "quantity": 10 }] }
          }
        },
        "responses": {
          "201": { "body": { "success": true, "statusCode": 201, "message": "Danh sách chuẩn bị xuất kho (Pick List) đã được sinh tự động." } }
        }
      }
    ],
    "Module_09_Field_Operation_Progress_Tracking": [
      {
        "path": "/api/v1/field/progress",
        "method": "PATCH",
        "description": "Cập nhật tiến trình thi công thực địa thời gian thực từ Mobile App của Leader Staff (Vận chuyển, lắp đặt, thu hồi) (UC-95).",
        "authentication": "Bearer JWT",
        "request_headers": { "Authorization": "Bearer <JWT_TOKEN>", "Content-Type": "application/json" },
        "request_parameters_body": {
