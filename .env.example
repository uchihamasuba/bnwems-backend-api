# BNWEMS Backend API — Environment Variables
# Copy this file to .env and fill in your actual values before running.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (MySQL 8.0+) ────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/bnwems"

# ── JWT Authentication ────────────────────────────────────────────────────────
# Use a long, random secret in production (e.g., openssl rand -base64 64)
JWT_SECRET="bnwems_super_secret_jwt_key_change_this_in_production"
JWT_EXPIRES_IN="8h"

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
